[
  {
    "doctype": "Print Format",
    "name": "Pharma Pick and Pack Slip",
    "doc_type": "Pick List",
    "format_data": "",
    "custom_format": 1,
    "html": "<style>\n@media screen {\n  .glass-sheet {\n    background: rgba(255, 255, 255, 0.88);\n    backdrop-filter: blur(14px);\n    border: 1px solid rgba(255, 255, 255, 0.7);\n    border-radius: 16px;\n    box-shadow: 0 10px 40px rgba(0,0,0,0.06);\n    padding: 30px;\n    max-width: 900px;\n    margin: 20px auto;\n  }\n}\n@media print {\n  .glass-sheet { padding: 0; margin: 0; }\n}\n.badge-pill {\n  padding: 4px 10px;\n  border-radius: 12px;\n  font-size: 11px;\n  font-weight: bold;\n}\n.badge-blue { background: #e0f2fe; color: #0369a1; }\n.badge-green { background: #dcfce7; color: #15803d; }\n</style>\n<div class=\"glass-sheet\" style=\"font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 13px; color: #1e293b;\">\n  <div style=\"display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #0284c7; padding-bottom: 12px; margin-bottom: 18px;\">\n    <div>\n      <h2 style=\"margin: 0; color: #0369a1; font-weight: 700; letter-spacing: -0.5px;\">KODESSY PHARMACEUTICAL</h2>\n      <div style=\"color: #64748b; font-size: 12px;\">Warehouse Fulfillment & Logistics Unit \u2014 Airport Zone, Malaysia</div>\n    </div>\n    <div style=\"text-align: right;\">\n      <span class=\"badge-pill badge-blue\">PICK & PACK SLIP</span>\n      <div style=\"font-weight: 700; font-size: 14px; margin-top: 5px;\">{{ doc.name }}</div>\n      <div style=\"color: #64748b; font-size: 11px;\">{{ doc.creation.strftime('%d %b %Y, %H:%M') if doc.creation else '' }}</div>\n    </div>\n  </div>\n\n  <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 20px;\">\n    <thead>\n      <tr style=\"background: #f1f5f9; text-transform: uppercase; font-size: 11px; color: #475569; letter-spacing: 0.5px;\">\n        <th style=\"padding: 10px; border-bottom: 2px solid #cbd5e1; text-align: left;\">Item & Description</th>\n        <th style=\"padding: 10px; border-bottom: 2px solid #cbd5e1; text-align: left;\">Warehouse Zone</th>\n        <th style=\"padding: 10px; border-bottom: 2px solid #cbd5e1; text-align: center;\">FEFO Batch No</th>\n        <th style=\"padding: 10px; border-bottom: 2px solid #cbd5e1; text-align: center;\">Expiry Date</th>\n        <th style=\"padding: 10px; border-bottom: 2px solid #cbd5e1; text-align: right;\">Pick Qty</th>\n        <th style=\"padding: 10px; border-bottom: 2px solid #cbd5e1; text-align: center;\">Check</th>\n      </tr>\n    </thead>\n    <tbody>\n      {% for item in doc.locations or doc.items %}\n      <tr style=\"border-bottom: 1px solid #e2e8f0;\">\n        <td style=\"padding: 12px 10px;\">\n          <div style=\"font-weight: 600; color: #0f172a;\">{{ item.item_code }}</div>\n          <div style=\"color: #64748b; font-size: 11px;\">{{ item.item_name }}</div>\n        </td>\n        <td style=\"padding: 12px 10px;\">\n          <span class=\"badge-pill badge-green\">{{ item.warehouse }}</span>\n        </td>\n        <td style=\"padding: 12px 10px; text-align: center; font-weight: 700; color: #0284c7;\">\n          {{ item.batch_no or 'FEFO Auto' }}\n        </td>\n        <td style=\"padding: 12px 10px; text-align: center; font-weight: 600;\">\n          {{ item.expiry_date or 'N/A' }}\n        </td>\n        <td style=\"padding: 12px 10px; text-align: right; font-weight: 700; font-size: 14px;\">\n          {{ item.qty or item.stock_qty }} {{ item.uom or item.stock_uom }}\n        </td>\n        <td style=\"padding: 12px 10px; text-align: center;\">\n          <div style=\"width: 18px; height: 18px; border: 2px solid #94a3b8; border-radius: 4px; display: inline-block;\"></div>\n        </td>\n      </tr>\n      {% endfor %}\n    </tbody>\n  </table>\n\n  <div style=\"margin-top: 30px; display: flex; justify-content: space-between; gap: 20px;\">\n    <div style=\"flex: 1; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px; background: #fafafa;\">\n      <div style=\"font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 600;\">Picked By</div>\n      <div style=\"margin-top: 25px; border-bottom: 1px dashed #94a3b8;\"></div>\n    </div>\n    <div style=\"flex: 1; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px; background: #fafafa;\">\n      <div style=\"font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 600;\">QA Verified</div>\n      <div style=\"margin-top: 25px; border-bottom: 1px dashed #94a3b8;\"></div>\n    </div>\n    <div style=\"flex: 1; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px; background: #fafafa;\">\n      <div style=\"font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 600;\">Driver Release</div>\n      <div style=\"margin-top: 25px; border-bottom: 1px dashed #94a3b8;\"></div>\n    </div>\n  </div>\n</div>",
    "standard": "Yes",
    "module": "Kodessy App"
  },
  {
    "doctype": "Print Format",
    "name": "Pharma Delivery Order (DO)",
    "doc_type": "Delivery Note",
    "format_data": "",
    "custom_format": 1,
    "html": "<div class=\"delivery-order\" style=\"font-family: Arial, sans-serif; font-size: 13px; line-height: 1.5;\">\n  <div style=\"border-bottom: 2px solid #004085; padding-bottom: 10px; margin-bottom: 15px;\">\n    <table style=\"width: 100%;\">\n      <tr>\n        <td>\n          <h2 style=\"margin: 0; color: #004085;\">KODESSY SDN BHD</h2>\n          <div>Pharmaceutical and Medical Device Importers & Distributors</div>\n          <div>Airport Logistics Zone, Malaysia</div>\n        </td>\n        <td style=\"text-align: right;\">\n          <h2 style=\"margin: 0;\">DELIVERY ORDER (DO)</h2>\n          <div><b>DO No:</b> {{ doc.name }}</div>\n          <div><b>Date:</b> {{ doc.posting_date }}</div>\n          <div><b>Dispatch Temp:</b> {{ doc.custom_temperature_recorded or '24\u00b0C Ambient' }}</div>\n        </td>\n      </tr>\n    </table>\n  </div>\n\n  <table style=\"width: 100%; margin-bottom: 15px; border: 1px solid #eee; padding: 8px;\">\n    <tr>\n      <td style=\"width: 50%;\">\n        <b>Deliver To:</b><br>\n        <b>{{ doc.customer_name }}</b><br>\n        {{ doc.shipping_address_display or doc.address_display or '' }}\n      </td>\n      <td style=\"width: 50%;\">\n        <b>Sales Order Ref:</b> {{ doc.items[0].against_sales_order if doc.items else 'N/A' }}<br>\n        <b>Delivery Movement:</b> {{ doc.custom_delivery_type or 'Standard Commercial' }}<br>\n        <b>Vehicle / Driver:</b> {{ doc.transporter_name or 'Company Delivery Vehicle' }}\n      </td>\n    </tr>\n  </table>\n\n  <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 20px;\">\n    <thead>\n      <tr style=\"background-color: #004085; color: #ffffff;\">\n        <th style=\"border: 1px solid #004085; padding: 8px;\">#</th>\n        <th style=\"border: 1px solid #004085; padding: 8px;\">Product Description</th>\n        <th style=\"border: 1px solid #004085; padding: 8px;\">Batch / Lot No</th>\n        <th style=\"border: 1px solid #004085; padding: 8px;\">Expiry Date</th>\n        <th style=\"border: 1px solid #004085; padding: 8px;\">Pack Size</th>\n        <th style=\"border: 1px solid #004085; padding: 8px;\">Delivered Qty</th>\n      </tr>\n    </thead>\n    <tbody>\n      {% for item in doc.items %}\n      <tr style=\"border: 1px solid #ddd;\">\n        <td style=\"border: 1px solid #ddd; padding: 8px; text-align: center;\">{{ loop.index }}</td>\n        <td style=\"border: 1px solid #ddd; padding: 8px;\">\n          <b>{{ item.item_name }}</b><br>\n          <small>Code: {{ item.item_code }}</small>\n        </td>\n        <td style=\"border: 1px solid #ddd; padding: 8px; text-align: center;\"><b>{{ item.batch_no or 'N/A' }}</b></td>\n        <td style=\"border: 1px solid #ddd; padding: 8px; text-align: center;\">{{ item.custom_expiry_date or item.expiry_date or 'N/A' }}</td>\n        <td style=\"border: 1px solid #ddd; padding: 8px; text-align: center;\">{{ item.custom_pack_size or '-' }}</td>\n        <td style=\"border: 1px solid #ddd; padding: 8px; text-align: right;\"><b>{{ item.qty }} {{ item.uom }}</b></td>\n      </tr>\n      {% endfor %}\n    </tbody>\n  </table>\n\n  <div style=\"margin-top: 40px;\">\n    <table style=\"width: 100%;\">\n      <tr>\n        <td style=\"width: 50%; text-align: center; padding-top: 40px; border-top: 1px dashed #999;\">\n          <b>Authorized Dispatcher (Kodessy)</b>\n        </td>\n        <td style=\"width: 10%;\"></td>\n        <td style=\"width: 40%; text-align: center; padding-top: 40px; border-top: 1px dashed #999;\">\n          <b>Received in Good Order (Customer Seal and Sign)</b><br>\n          <small>Temp & Packaging Verified upon Receipt</small>\n        </td>\n      </tr>\n    </table>\n  </div>\n</div>",
    "standard": "Yes",
    "module": "Kodessy App"
  }
]